########################################
# ENVIRONMENT
########################################
ENV=development
# development | staging | production


########################################
# FRONTEND (Next.js)
########################################

# Public API base URL (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public app name
NEXT_PUBLIC_APP_NAME=Electro Repair Platform

# Public support email
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com


########################################
# BACKEND (FastAPI)
########################################

# Backend environment
BACKEND_ENV=development

# Backend host configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Secret key (JWT, password hashing, etc.)
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY

# Token configuration
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256


########################################
# DATABASE
########################################

DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=electro_repair
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Full database URL (optional, backend can build it dynamically)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/electro_repair


########################################
# STORAGE (IMAGES / VIDEOS)
########################################

# Storage provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local

# Local storage path
LOCAL_STORAGE_PATH=./uploads

# AWS S3 (if used)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET=electro-repair-media
AWS_REGION=eu-west-1


########################################
# EMAIL (NOTIFICATIONS)
########################################

EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com


########################################
# PUSH / REAL-TIME (OPTIONAL)
########################################

# Firebase Cloud Messaging
FCM_SERVER_KEY=CHANGE_ME

# WebSockets
WEBSOCKET_ENABLED=true


########################################
# SECURITY & CORS
########################################

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60


########################################
# LOGGING & MONITORING
########################################

LOG_LEVEL=info
# debug | info | warning | error

SENTRY_DSN=
