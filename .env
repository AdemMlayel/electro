########################################
# ENVIRONMENT
########################################
ENV=development
BACKEND_ENV=development


########################################
# FRONTEND (Next.js)
########################################
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
NEXT_PUBLIC_APP_NAME=Electro Repair Platform
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com


########################################
# BACKEND (PHP)
########################################
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ONE secret key only
SECRET_KEY=super_secret_key_123

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256


########################################
# DATABASE (Docker)
########################################
DB_ENGINE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=electro_repair
DB_USER=postgres
DB_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@db:5432/electro_repair


########################################
# STORAGE
########################################
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./public/uploads


########################################
# SECURITY & CORS
########################################
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
