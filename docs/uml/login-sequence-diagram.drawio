        <mxCell id="m1" value="1. Enter email and password" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="actor" target="ui"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="230" as="sourcePoint"/><mxPoint x="375" y="230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. POST /api/v1/auth/login" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="290" as="sourcePoint"/><mxPoint x="655" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="3. SELECT user by email" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="655" y="350" as="sourcePoint"/><mxPoint x="955" y="350" as="targetPoint"/></mxGeometry></mxCell>
