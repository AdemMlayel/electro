        <mxCell id="m6" value="6. Return access token" style="endArrow=open;html=1;rounded=0;dashed=1;strokeColor=#555555;fontSize=12;" edge="1" parent="1" source="jwt" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="1185" y="605" as="sourcePoint"/><mxPoint x="655" y="605" as="targetPoint"/></mxGeometry></mxCell>
